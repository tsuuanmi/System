#!/usr/bin/env node
// The `system` wrapper (ADR-0004 decision 2): `system init` creates or refreshes
// the `system` DSH profile (and, on Linux, the Host's user unit); every other
// command runs `dsh --profile system "$@"`.
import { spawn, spawnSync } from 'node:child_process'
import { existsSync, mkdirSync, readFileSync, readdirSync, writeFileSync } from 'node:fs'
import { constants, homedir, userInfo } from 'node:os'
import { dirname, join, resolve } from 'node:path'
import { fileURLToPath } from 'node:url'
import { MIN_NODE, nodeChoice, serviceMode, unitPath, unitText } from './service.mjs'

const PROFILE = 'system'
const repo = resolve(dirname(fileURLToPath(import.meta.url)), '..')
const home = process.env.DSH_HOME || join(homedir(), '.dsh')
const profileDir = join(home, 'profiles', PROFILE)
const dshBin = join(repo, 'node_modules', '@deepseek-ai', 'dsh', 'lib', 'bin.js')

function fail(message) {
  process.stderr.write(`system: ${message}\n`)
  process.exit(1)
}

/** Run a child with this terminal; SIGTERM sent here reaches it, and its exit status is the result. */
function run(command, args, env) {
  return new Promise((done) => {
    const child = spawn(command, args, { stdio: 'inherit', env })
    child.on('error', (error) => fail(error.message))
    child.on('exit', (code, signal) => done(code ?? 128 + (constants.signals[signal] ?? 0)))
    process.on('SIGTERM', () => child.kill('SIGTERM'))
    // At a terminal, Ctrl-C reaches the child itself, and a second one from here would force its exit.
    process.on('SIGINT', () => { if (!process.stdin.isTTY) child.kill('SIGINT') })
  })
}

const nodes = join(homedir(), '.nvm', 'versions', 'node')
const choice = nodeChoice(process.versions.node, existsSync(nodes) ? readdirSync(nodes) : [])
if (choice.use === 'none') fail(`DSH 0.2.2-rc.1 needs Node >=${MIN_NODE}; this is ${process.version} and no Node 24 of that version is under ${nodes}: run \`nvm install 24\``)
if (choice.use === 'other') process.exit(await run(join(nodes, choice.version, 'bin', 'node'), [fileURLToPath(import.meta.url), ...process.argv.slice(2)], process.env))
if (!existsSync(dshBin)) fail(`DSH is not installed at ${dshBin}: run \`corepack pnpm install\` in ${repo}`)
if (!existsSync(join(repo, 'packages', 'app', 'lib', 'index.js'))) fail(`the System app is not built: run \`corepack pnpm build\` in ${repo}`)

function dsh(args) {
  // `dsh plugin` runs pnpm from PATH: use the workspace's pinned copy.
  const path = [join(repo, 'node_modules', '.bin'), process.env.PATH].filter(Boolean).join(':')
  return run(process.execPath, [dshBin, ...args], { ...process.env, DSH_HOME: home, PATH: path })
}

/** The Host's user unit (default home only), or why there is none. It is never enabled or started here. */
function installService(args) {
  const mode = serviceMode({ home, homedir: homedir(), platform: process.platform, args, env: process.env })
  if (mode === 'skip') return
  if (mode === 'foreground') {
    process.stdout.write(`no service for ${home} (only ~/.dsh gets one): run \`system host\` in the foreground, with DSH_HOME=${home}\n`)
    return
  }
  const unit = unitPath(homedir())
  mkdirSync(dirname(unit), { recursive: true })
  writeFileSync(unit, unitText({ node: process.execPath, entry: join(repo, 'bin', 'system'), home, path: process.env.PATH ?? '' }))
  process.stdout.write(`service unit written: ${unit}\n`)
  for (const [command, ...rest] of [['systemctl', '--user', 'daemon-reload'], ['loginctl', 'enable-linger', userInfo().username]]) {
    const ran = spawnSync(command, rest, { stdio: 'inherit' })
    if (ran.error || ran.status !== 0) process.stderr.write(`system: \`${[command, ...rest].join(' ')}\` failed${ran.error ? `: ${ran.error.message}` : ` with status ${ran.status}`}\n`)
  }
  process.stdout.write('to run the Host as a service: systemctl --user enable --now system\n')
}

async function init(args) {
  const manifestPath = join(profileDir, 'package.json')
  const current = existsSync(manifestPath) ? JSON.parse(readFileSync(manifestPath, 'utf8')) : {}
  // The bundle list is exactly the System bundle; other manifest fields are kept.
  const manifest = {
    ...current,
    name: `dsh-profile-${PROFILE}`,
    private: true,
    dependencies: { ...current.dependencies, '@system/bundle': `link:${join(repo, 'packages', 'bundle')}` },
    dsh: { ...current.dsh, profile: { ...current.dsh?.profile, bundles: ['@system/bundle'] } },
  }
  mkdirSync(profileDir, { recursive: true, mode: 0o700 })
  writeFileSync(manifestPath, `${JSON.stringify(manifest, null, 2)}\n`)
  try {
    // The operator's patch layer is created once and never overwritten.
    writeFileSync(join(profileDir, 'cordis.patch.yml'), '# Operator overrides for the system profile.\n[]\n', { flag: 'wx' })
  } catch (error) {
    if (error.code !== 'EEXIST') throw error
  }
  const status = await dsh(['plugin', '--profile', PROFILE, 'install'])
  if (status !== 0) fail(`dsh plugin install failed with status ${status}`)
  process.stdout.write(`profile ready: ${profileDir}\n`)
  installService(args)
}

const args = process.argv.slice(2)
if (args[0] === 'init') await init(args.slice(1))
else {
  if (!existsSync(join(profileDir, 'package.json'))) fail(`no ${PROFILE} profile under ${home}/profiles: run \`system init\` first`)
  process.exit(await dsh(['--profile', PROFILE, ...args]))
}
