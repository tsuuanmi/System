#!/usr/bin/env node
// The `system` wrapper (ADR-0004 decision 2): `system init` creates or refreshes
// the `system` DSH profile (and, on Linux, the Host's user unit); `update` moves the install
// to the newest checked commit of `main` (update.mjs); `host` and
// `doctor` run `dsh --profile system "$@"`, and every other command is a thin
// client of the Host (packages/app/src/client.ts).
import { spawn, spawnSync } from 'node:child_process'
import { existsSync, mkdirSync, readFileSync, readdirSync, readlinkSync, renameSync, rmSync, symlinkSync, writeFileSync } from 'node:fs'
import { constants, homedir, userInfo } from 'node:os'
import { dirname, join, resolve } from 'node:path'
import { fileURLToPath, pathToFileURL } from 'node:url'
import { MIN_NODE, hostCommand, installRoot, nodeChoice, serviceMode, supervise, unitPath, unitText } from './service.mjs'
import { update } from './update.mjs'

const PROFILE = 'system'
const repo = resolve(dirname(fileURLToPath(import.meta.url)), '..')
// A release of the install runs as the install's `current` link, so the profile, the unit and the Host's
// look for new code all follow a switch of that link (`system update`); a checkout runs as itself.
const install = installRoot(repo, existsSync)
process.env.SYSTEM_CODE ??= install
const home = process.env.DSH_HOME || join(homedir(), '.dsh')
const profileDir = join(home, 'profiles', PROFILE)
const dshBin = join(repo, 'node_modules', '@deepseek-ai', 'dsh', 'lib', 'bin.js')

function fail(message) {
  process.stderr.write(`system: ${message}\n`)
  process.exit(1)
}

/** Run a child with this terminal; SIGTERM sent here reaches it, and its exit status is the result. */
function run(command, args, env) {
  return new Promise((done) => {
    const child = spawn(command, args, { stdio: 'inherit', env })
    child.on('error', (error) => fail(error.message))
    const onTerm = () => child.kill('SIGTERM')
    // At a terminal, Ctrl-C reaches the child itself, and a second one from here would force its exit.
    const onInt = () => { if (!process.stdin.isTTY) child.kill('SIGINT') }
    child.on('exit', (code, signal) => {
      process.off('SIGTERM', onTerm)
      process.off('SIGINT', onInt)
      done(code ?? 128 + (constants.signals[signal] ?? 0))
    })
    process.on('SIGTERM', onTerm)
    process.on('SIGINT', onInt)
  })
}

const nodes = join(homedir(), '.nvm', 'versions', 'node')
const choice = nodeChoice(process.versions.node, existsSync(nodes) ? readdirSync(nodes) : [])
if (choice.use === 'none') fail(`DSH 0.2.2-rc.1 needs Node >=${MIN_NODE}; this is ${process.version} and no Node 24 of that version is under ${nodes}: run \`nvm install 24\``)
if (choice.use === 'other') process.exit(await run(join(nodes, choice.version, 'bin', 'node'), [fileURLToPath(import.meta.url), ...process.argv.slice(2)], process.env))
if (!existsSync(dshBin)) fail(`DSH is not installed at ${dshBin}: run \`corepack pnpm install\` in ${repo}`)
if (!existsSync(join(repo, 'packages', 'app', 'lib', 'index.js'))) fail(`the System app is not built: run \`corepack pnpm build\` in ${repo}`)

/** Every command but `init`, `update`, `host` and `doctor` goes to the Host; a leading flag is for DSH. */
const thin = (args) => args.length > 0 && !args[0].startsWith('-') && !['host', 'doctor'].includes(args[0])

function dsh(args) {
  // `dsh plugin` runs pnpm from PATH: use the workspace's pinned copy.
  const path = [join(repo, 'node_modules', '.bin'), process.env.PATH].filter(Boolean).join(':')
  return run(process.execPath, [dshBin, ...args], { ...process.env, DSH_HOME: home, PATH: path })
}

/** The Host's user unit (default home only), or why there is none. It is never enabled or started here. */
function installService(args) {
  const mode = serviceMode({ home, homedir: homedir(), platform: process.platform, args, env: process.env })
  if (mode === 'skip') return
  if (mode === 'foreground') {
    process.stdout.write(`no service for ${home} (only ~/.dsh gets one): run \`system host\` in the foreground, with DSH_HOME=${home}\n`)
    return
  }
  const unit = unitPath(homedir())
  mkdirSync(dirname(unit), { recursive: true })
  // An install's profile file (`~/.system/profile.yml`: the Accounts and Effects of this machine) is the Host's patch.
  const profile = install === repo ? undefined : join(dirname(install), 'profile.yml')
  writeFileSync(unit, unitText({ node: process.execPath, entry: join(install, 'bin', 'system'), home, path: process.env.PATH ?? '', patch: profile && existsSync(profile) ? profile : undefined }))
  process.stdout.write(`service unit written: ${unit}\n`)
  for (const [command, ...rest] of [['systemctl', '--user', 'daemon-reload'], ['loginctl', 'enable-linger', userInfo().username]]) {
    const ran = spawnSync(command, rest, { stdio: 'inherit' })
    if (ran.error || ran.status !== 0) process.stderr.write(`system: \`${[command, ...rest].join(' ')}\` failed${ran.error ? `: ${ran.error.message}` : ` with status ${ran.status}`}\n`)
  }
  process.stdout.write('to run the Host as a service: systemctl --user enable --now system\n')
}

async function init(args) {
  const manifestPath = join(profileDir, 'package.json')
  const current = existsSync(manifestPath) ? JSON.parse(readFileSync(manifestPath, 'utf8')) : {}
  // The bundle list is exactly the System bundle; other manifest fields are kept.
  const manifest = {
    ...current,
    name: `dsh-profile-${PROFILE}`,
    private: true,
    dependencies: { ...current.dependencies, '@system/bundle': `link:${join(install, 'packages', 'bundle')}` },
    dsh: { ...current.dsh, profile: { ...current.dsh?.profile, bundles: ['@system/bundle'] } },
  }
  mkdirSync(profileDir, { recursive: true, mode: 0o700 })
  writeFileSync(manifestPath, `${JSON.stringify(manifest, null, 2)}\n`)
  try {
    // The operator's patch layer is created once and never overwritten.
    writeFileSync(join(profileDir, 'cordis.patch.yml'), '# Operator overrides for the system profile.\n[]\n', { flag: 'wx' })
  } catch (error) {
    if (error.code !== 'EEXIST') throw error
  }
  const status = await dsh(['plugin', '--profile', PROFILE, 'install'])
  if (status !== 0) fail(`dsh plugin install failed with status ${status}`)
  process.stdout.write(`profile ready: ${profileDir}\n`)
  installService(args)
}

/** `system update [--wait <minutes>]`: see update.mjs. */
async function runUpdate(args) {
  const at = args.indexOf('--wait')
  const waitMs = (at >= 0 ? Number(args[at + 1]) : 75) * 60_000
  if (!(waitMs > 0)) fail('--wait takes a number of minutes')
  const base = process.env.SYSTEM_INSTALL || join(homedir(), '.system')
  mkdirSync(join(base, 'releases'), { recursive: true })
  const path = [dirname(process.execPath), process.env.PATH].filter(Boolean).join(':')
  /** Run a command with its output shown and kept; resolves its status and output. */
  const capture = (command, args, cwd) => new Promise((done) => {
    const child = spawn(command, args, { cwd, stdio: ['inherit', 'pipe', 'inherit'], env: { ...process.env, PATH: path } })
    let stdout = ''
    child.stdout.on('data', (data) => { stdout += data; process.stdout.write(data) })
    child.on('error', (error) => done({ status: 127, stdout: `${error.message}\n` }))
    child.on('exit', (code) => done({ status: code ?? 1, stdout }))
  })
  const origin = spawnSync('git', ['-C', repo, 'remote', 'get-url', 'origin'], { encoding: 'utf8' }).stdout.trim()
  return update({
    install: base,
    cli: join(repo, 'bin', 'system'),
    origin,
    run: capture,
    exists: existsSync,
    readlink: (link) => { try { return readlinkSync(link) } catch { return undefined } },
    switchLink: (link, target) => { rmSync(`${link}.new`, { force: true }); symlinkSync(target, `${link}.new`); renameSync(`${link}.new`, link) },
    releases: () => readdirSync(join(base, 'releases')),
    // A hello of the new code: accepted only by a Host running it; to a Host of other code, the ask to upgrade.
    probe: async (release) => {
      const { VERSION, connectHello } = await import(pathToFileURL(join(release, 'packages', 'host', 'lib', 'index.js')).href)
      const { socketPath } = await import(pathToFileURL(join(release, 'packages', 'host', 'lib', 'process.js')).href)
      try {
        const client = await connectHello(socketPath(home), { version: VERSION, caller: { type: 'agent', operatorId: userInfo().username } })
        client.close()
        return true
      } catch {
        return false
      }
    },
    sleep: (ms) => new Promise((resolve) => setTimeout(resolve, ms)),
    now: Date.now,
    log: (line) => process.stderr.write(`system update: ${line}\n`),
    waitMs,
  })
}

const args = process.argv.slice(2)
if (args[0] === 'init') await init(args.slice(1))
else if (args[0] === 'update') process.exit(await runUpdate(args.slice(1)))
else if (thin(args)) {
  // The Host's thin client does not boot DSH: no profile is needed to ask a Host.
  const { main } = await import(pathToFileURL(join(repo, 'packages', 'app', 'lib', 'client.js')).href)
  process.exit(await main(args, home))
} else {
  if (!existsSync(join(profileDir, 'package.json'))) fail(`no ${PROFILE} profile under ${home}/profiles: run \`system init\` first`)
  if (hostCommand(args) && args.includes('--supervise')) {
    // The development setup, without systemd: stay small, and run the Host again after it stopped for new code.
    let stopped = false
    for (const signal of ['SIGTERM', 'SIGINT']) process.on(signal, () => { stopped = true })
    const inner = args.filter((arg) => arg !== '--supervise')
    // Each run starts `bin/system` of the install afresh, so after an upgrade it runs the code `current` points to now.
    process.exit(await supervise({ run: () => run(process.execPath, [join(install, 'bin', 'system'), ...inner], process.env), stopped: () => stopped, log: (line) => process.stderr.write(`system host: ${line}\n`) }))
  }
  process.exit(await dsh(['--profile', PROFILE, ...args]))
}
