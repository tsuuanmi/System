#!/bin/sh
# Runs the fast checks before a hand push to `dev` (Item rb-2). Enable with
# `git config core.hooksPath tools/hooks`. Skip once with `git push --no-verify`.
# Only a hand push to the real `origin` is checked (Escaped defect 01d80c6a): a push to another remote name, or to a local path or
# file URL (a stand-in origin, as tools/upgrade-rehearsal.mjs pushes to), does nothing.
[ "$1" = "origin" ] || exit 0
case "$2" in /*|./*|../*|file:*) exit 0;; esac
# Git runs a hook with GIT_DIR and friends set to the real repository; a check that runs git (a test's `git init --bare`) would act on it.
for var in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do
  case "$var" in GIT_CONFIG_*|GIT_SSH*|GIT_TERMINAL_PROMPT|GIT_ASKPASS|GIT_TRACE*|GIT_AUTHOR_*|GIT_COMMITTER_*|GIT_EXEC_PATH) ;; *) unset "$var" ;; esac
done
here=$(cd "$(dirname "$0")" && pwd) || exit 1
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ "$remote_ref" = "refs/heads/dev" ] || continue
  root=$(git rev-parse --show-toplevel) || exit 1
  cd "$root" || exit 1
  # The checks run with the repository's Node (engines.node), not the shell's (fl-3, third place): the same `nodeBin` the checks step uses.
  # Only asking for it uses the shell's Node, found by `command -v`; every later spawn names the chosen Node's own path (Item ns-2).
  boot=$(command -v node) || { echo "pre-push: no node on PATH; install Node, or bypass with 'git push --no-verify'." >&2; exit 1; }
  if ! bin=$("$boot" "$here/../node-bin.ts" "$root"); then
    echo "pre-push: refusing the push to dev: no suitable Node for this repository (see above). Install it, or bypass with 'git push --no-verify'." >&2
    exit 1
  fi
  [ -n "$bin" ] || bin=$(dirname "$boot")
  PATH="$bin:$PATH"
  # check <name shown> <command...>: runs one check, refusing the push when it fails.
  check() {
    label=$1; shift
    "$@" >&2 || { echo "pre-push: refusing the push to dev: '$label' failed. Fix it, or bypass with 'git push --no-verify'." >&2; exit 1; }
  }
  check 'python3 tools/docs.py check' python3 tools/docs.py check
  check 'node tools/check-status.ts STATUS.md' "$bin/node" tools/check-status.ts STATUS.md
  check 'corepack pnpm typecheck' "$bin/corepack" pnpm typecheck
  check 'corepack pnpm test' "$bin/corepack" pnpm test
done
exit 0
