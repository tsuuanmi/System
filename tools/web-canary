#!/usr/bin/env node
// The Website Worker canary (PLAN milestone WW, step 4): the same fixed Research
// question on each registered chatgpt-web Account, and a report read from System's
// own Work records. It uses only `bin/system` (SYSTEM_BIN overrides it, for tests)
// and stores nothing of its own.
//
//   tools/web-canary                       run it on every chatgpt-web Account, one at a time
//   tools/web-canary --task                store the canary Task and print its Artifact ID
//   tools/web-canary --report [--since T]  each run classified, the Worker step rate, the launch and wait times and the model and Power seen per Account and the WW gate (exit 3: not holding)
import { spawnSync } from 'node:child_process'
import { dirname, join, resolve } from 'node:path'
import { fileURLToPath } from 'node:url'

const repo = resolve(dirname(fileURLToPath(import.meta.url)), '..')
const system = process.env.SYSTEM_BIN || join(repo, 'bin', 'system')
const workflow = join(repo, 'workflows', 'research.yaml')

// A question with a stable answer and one page the citation verifier can read: the
// canary measures the Website Worker, not whatever third-party page it picks. The
// text is the Task's identity: `system task new` stores it content-addressed, so the
// Artifact ID is the same every time. Changing a word starts a new series; the
// earlier texts stay listed so the report still counts their Works, apart.
const QUESTION = 'What is the capital of France? Cite the English Wikipedia article that says so (https://en.wikipedia.org/...).'
const OLDER_QUESTIONS = ['What is the capital of France? Cite one page that says so.']
// The Worker step of workflows/research.yaml; the verifier step is `citations`.
const WORKER_STEP = 'investigate'
const VERIFIER_STEP = 'citations'
// The WW gate: at least this many runs over both Accounts, at least this share accepted.
const GATE_RUNS = 50
const GATE_RATE = 0.95
const GATE_ACCOUNTS = 2
const SUBMIT_TIMEOUT_MS = 30 * 60 * 1000

function fail(message) {
  process.stderr.write(`web-canary: ${message}\n`)
  process.exit(1)
}

function sys(args, timeout = 120_000) {
  const ran = spawnSync(system, args, { encoding: 'utf8', timeout })
  if (ran.error) fail(`cannot run ${system}: ${ran.error.message}`)
  return ran
}

function ok(args) {
  const ran = sys(args)
  if (ran.status !== 0) fail(`system ${args.join(' ')} failed: ${(ran.stderr || ran.stdout).trim()}`)
  return ran.stdout
}

const taskFor = (text) => ok(['task', 'new', '--text', text]).trim().split('\n').at(-1)
const canaryTask = () => taskFor(QUESTION)

/** The Accounts of the chatgpt-web runtime that are registered Workers, from `system workers`. */
function accounts() {
  const lines = ok(['workers']).split('\n')
  const registered = (lines.find((l) => l.startsWith('registered:')) ?? '').slice('registered:'.length).split(',').map((r) => r.trim()).filter(Boolean)
  return lines.flatMap((line) => {
    const [ref] = line.trim().split(/\s+/)
    return /\(chatgpt-web\)\s*$/.test(line) && registered.includes(ref) ? [ref] : []
  })
}

const show = (workId) => JSON.parse(ok(['work', 'show', workId]))
const seconds = (record) => (Date.parse(record.events.at(-1).at) - Date.parse(record.events[0].at)) / 1000

function runAll() {
  const refs = accounts()
  if (!refs.length) fail('no registered chatgpt-web Account (see system workers)')
  const input = canaryTask()
  for (const ref of refs) {
    const submitted = sys(['work', 'submit', '--workflow', workflow, '--input', input, '--worker', ref], SUBMIT_TIMEOUT_MS)
    const workId = submitted.stdout.trim().split('\n')[0]
    if (!workId?.startsWith('work:')) {
      process.stdout.write(`${ref}  -  refused  0.0\n`)
      process.stderr.write(`web-canary: ${ref}: ${(submitted.stderr || submitted.stdout).trim()}\n`)
      continue
    }
    const record = show(workId)
    process.stdout.write(`${ref}  ${workId}  ${record.state.status}  ${seconds(record).toFixed(1)}\n`)
  }
}

/** The reason on the last event of `type` for a step, if any. */
const eventReason = (record, type, stepId) => record.events.findLast((e) => e.type === type && e.stepId === stepId)?.reason || undefined

/**
 * One finished Work as a run: `workerOk` (the Worker step succeeded with all its outputs), `accepted`, and for a
 * run that did not pass its `kind` and `detail`. A Worker step failure is `worker-failed` (a `site error:` reason
 * also `site`); a succeeded Worker step with a citation check that did not pass is `verifier`; else `other`.
 */
function classify(record) {
  const { status, steps, reason } = record.state
  const worker = steps[WORKER_STEP]
  const workerOk = worker?.state === 'succeeded' && Object.keys(worker.outputs ?? {}).length > 0
  const accepted = status === 'succeeded'
  const run = { workerOk, accepted, passed: workerOk && accepted }
  if (run.passed) return run
  const stage = Object.entries(steps).find(([, s]) => s.state === 'failed')?.[0]
  if (!workerOk) {
    const why = eventReason(record, 'observed', WORKER_STEP) ?? reason ?? status
    return { ...run, kind: 'worker-failed', site: why.startsWith('site error:'), detail: `${WORKER_STEP}: ${why}` }
  }
  const verifier = steps[VERIFIER_STEP]
  if (verifier && (verifier.state === 'failed' || (verifier.verdict && verifier.verdict !== 'pass'))) {
    return { ...run, kind: 'verifier', detail: eventReason(record, 'verified', VERIFIER_STEP) ?? reason ?? `${VERIFIER_STEP} ${verifier.verdict ?? verifier.state}` }
  }
  return { ...run, kind: 'other', detail: reason ? `${stage ?? status}: ${reason}` : (stage ?? status) }
}

/** A reason longer than this is printed up to it. */
const MAX_DETAIL = 200

/** Print the per-Account and total lines of one canary version, then each run that did not pass. */
function section(runs) {
  const pct = (n, of) => (of ? `${((n / of) * 100).toFixed(1)}%` : '-')
  const line = (name, set) => {
    const count = (kind) => set.filter((r) => r.kind === kind).length
    const passed = set.filter((r) => r.passed).length
    const workerOk = set.filter((r) => r.workerOk).length
    const sites = set.filter((r) => r.site).length
    const site = sites ? ` (site error ${sites})` : ''
    process.stdout.write(`${name.padEnd(18)} runs ${set.length}  passed ${passed} (${pct(passed, set.length)})  worker step ok ${workerOk} (${pct(workerOk, set.length)})  worker-failed ${count('worker-failed')}${site}  verifier ${count('verifier')}  other ${count('other')}\n`)
    return { passed, workerOk, rate: set.length ? passed / set.length : 0, workerRate: set.length ? workerOk / set.length : 0 }
  }
  const names = [...new Set(runs.map((r) => r.account))].sort()
  for (const name of names) line(name, runs.filter((r) => r.account === name))
  const total = line('total', runs)
  for (const r of runs.filter((r) => !r.passed)) process.stdout.write(`  ${r.workId}  ${r.account}  ${r.kind}: ${r.detail.length > MAX_DETAIL ? `${r.detail.slice(0, MAX_DETAIL)}…` : r.detail}\n`)
  return { names, total }
}

/** The finished Works whose input is `input`, oldest first. */
function runsOf(input, since) {
  const listed = ok(['work', 'list']).split('\n').filter(Boolean).map((line) => line.split(/\s+/)[0])
  const runs = []
  for (const workId of listed) {
    const record = show(workId)
    const admitted = record.events[0]
    if (admitted.input !== input || record.state.status === 'running') continue
    if (since && Date.parse(admitted.at) < since) continue
    runs.push({ workId, at: admitted.at, account: admitted.worker ?? 'unknown', evidence: record.state.steps[WORKER_STEP]?.partial?.evidence, ...classify(record) })
  }
  return runs.sort((a, b) => (a.at < b.at ? -1 : a.at > b.at ? 1 : 0))
}

/** The value at fraction `q` of the sorted `values` (nearest rank). */
const quantile = (values, q) => values[Math.max(0, Math.ceil(q * values.length) - 1)]

/** Median and p95 of the launch and wait stages per Account, from the evidence each attempt reports; runs without evidence are counted apart. */
function stageTimes(runs) {
  const times = new Map()
  const without = new Map()
  for (const run of runs) {
    if (!run.evidence) {
      without.set(run.account, (without.get(run.account) ?? 0) + 1)
      continue
    }
    const read = sys(['artifact', 'cat', run.evidence])
    if (read.status !== 0) continue
    const evidence = JSON.parse(read.stdout)
    const byStage = times.get(run.account) ?? { launch: [], wait: [], model: new Map(), power: new Map() }
    // WW8a: what the page showed, never set; an attempt that read none (older evidence, an unreadable control) counts as "unread".
    for (const key of ['model', 'power']) byStage[key].set(evidence[key] ?? 'unread', (byStage[key].get(evidence[key] ?? 'unread') ?? 0) + 1)
    for (const stage of evidence.stages ?? []) if (stage.stage in byStage && typeof stage.elapsedMs === 'number') byStage[stage.stage].push(stage.elapsedMs / 1000)
    times.set(run.account, byStage)
  }
  process.stdout.write('stage times (s, median / p95 of runs with evidence)\n')
  for (const name of [...new Set([...times.keys(), ...without.keys()])].sort()) {
    const byStage = times.get(name) ?? { launch: [], wait: [], model: new Map(), power: new Map() }
    const cell = (list) => (list.length ? `${quantile([...list].sort((a, b) => a - b), 0.5).toFixed(1)} / ${quantile([...list].sort((a, b) => a - b), 0.95).toFixed(1)} (n ${list.length})` : '-')
    const missing = without.get(name) ? `  (${without.get(name)} without evidence)` : ''
    process.stdout.write(`  ${name.padEnd(18)} launch ${cell(byStage.launch)}  wait ${cell(byStage.wait)}${missing}\n`)
  }
  process.stdout.write('model and Power seen (runs with evidence)\n')
  for (const name of [...times.keys()].sort()) {
    const counts = (map) => [...map].sort(([a], [b]) => (a < b ? -1 : 1)).map(([value, n]) => `${value} ${n}`).join(', ')
    process.stdout.write(`  ${name.padEnd(18)} model ${counts(times.get(name).model)}  power ${counts(times.get(name).power)}\n`)
  }
}

function report(since) {
  const current = runsOf(canaryTask(), since)
  const older = OLDER_QUESTIONS.map((text) => runsOf(taskFor(text), since)).flat()
  process.stdout.write('canary (current)\n')
  const { names, total } = section(current)
  stageTimes(current)
  if (older.length) {
    process.stdout.write('\nolder canary version (not in the gate)\n')
    section(older)
    process.stdout.write('\n')
  }
  // A run passes the gate when the Worker step succeeded with its outputs and the Work was accepted.
  const problems = []
  if (current.length < GATE_RUNS) problems.push(`${current.length} of ${GATE_RUNS} runs`)
  if (total.rate < GATE_RATE) problems.push(`${(total.rate * 100).toFixed(1)}% passed, needs ${GATE_RATE * 100}%`)
  if (names.length < GATE_ACCOUNTS) problems.push(`only ${names.length} Account${names.length === 1 ? '' : 's'}`)
  process.stdout.write(`worker step: ${(total.workerRate * 100).toFixed(1)}% ok\n`)
  process.stdout.write(problems.length ? `gate: does not hold (${problems.join('; ')})\n` : 'gate: holds\n')
  process.exit(problems.length ? 3 : 0)
}

const args = process.argv.slice(2)
if (args[0] === '--task') process.stdout.write(`${canaryTask()}\n`)
else if (args[0] === '--report') {
  const at = args.indexOf('--since')
  const since = at < 0 ? undefined : Date.parse(args[at + 1] ?? '')
  if (at >= 0 && Number.isNaN(since)) fail('--since needs an ISO date, such as 2026-11-08T00:00:00Z')
  report(since)
} else if (args.length) fail('usage: web-canary [--task | --report [--since <ISO>]]')
else runAll()
